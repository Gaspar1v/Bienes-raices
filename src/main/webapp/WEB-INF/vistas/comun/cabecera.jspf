<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${empty titulo ? 'Bienes Raíces S.A.C.' : titulo}"/></title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css">
</head>
<body>
<header class="barra">
    <a class="marca" href="${pageContext.request.contextPath}/app/panel">Bienes Raíces <span>S.A.C.</span></a>
    <c:if test="${not empty sessionScope.usuario}">
        <nav>
            <span class="usuario"><c:out value="${sessionScope.usuario.nombres}"/> · <c:out value="${sessionScope.usuario.rol.etiqueta}"/></span>
            <form method="post" action="${pageContext.request.contextPath}/logout" class="en-linea">
                <input type="hidden" name="_csrf" value="${csrf}">
                <button type="submit" class="boton-borde">Cerrar sesión</button>
            </form>
        </nav>
    </c:if>
</header>
<main class="contenido">
<c:if test="${not empty sessionScope.flash}">
    <div class="alerta exito" role="status"><c:out value="${sessionScope.flash}"/></div>
    <c:remove var="flash" scope="session"/>
</c:if>
