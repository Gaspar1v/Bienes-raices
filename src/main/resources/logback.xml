<?xml version="1.0" encoding="UTF-8"?>

<configuration scan="true" scanPeriod="60 seconds">

    <property name="LOG_DIR" value="${LOG_DIR:-logs}" />
    <property name="PATRON"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] usuario=%X{usuario:-sistema} ip=%X{ip:--} %logger{36} - %msg%n" />

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATRON}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/inmobiliaria.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/inmobiliaria.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATRON}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="AUDITORIA_ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/auditoria.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/auditoria.%d{yyyy-MM}.log.gz</fileNamePattern>
            <maxHistory>24</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} usuario=%X{usuario:-sistema} ip=%X{ip:--} %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ASYNC_ARCHIVO" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="ARCHIVO" />
    </appender>

    <logger name="AUDITORIA" level="INFO" additivity="false">
        <appender-ref ref="AUDITORIA_ARCHIVO" />
        <appender-ref ref="CONSOLA" />
    </logger>

    <logger name="pe.bienesraices" level="DEBUG" />

    <logger name="com.mysql" level="WARN" />

    <root level="INFO">
        <appender-ref ref="CONSOLA" />
        <appender-ref ref="ASYNC_ARCHIVO" />
    </root>
</configuration>
